# Copy this file to `.env` and fill in the values.

# --- Database -----------------------------------------------------------
# Local development (SQLite):
DATABASE_URL="file:./database.sqlite3"
# Production (PostgreSQL) — also switch `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth ---------------------------------------------------------------
# Secret used to sign JWTs (auth tokens and password-reset tokens).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# --- Email (Resend) -----------------------------------------------------
# Used to send password-reset OTP emails.
#
# Setup:
#   1. Create an account at https://resend.com
#   2. Create an API key at https://resend.com/api-keys and paste it below.
#   3. Verify a sending domain at https://resend.com/domains, then set
#      EMAIL_FROM to an address on that domain. Without a verified domain
#      you can use "onboarding@resend.dev", but Resend will only deliver
#      to the email address of your own Resend account.
#
# If RESEND_API_KEY is left empty (local dev), no email is sent — the OTP
# is printed to the server console instead so the flow stays testable.
RESEND_API_KEY=""
EMAIL_FROM="Virtual Mailbox <onboarding@resend.dev>"
